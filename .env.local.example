# Copia este archivo como `.env.local` y completa tus credenciales.
# Las obtienes en: Supabase → Project Settings → API

# Clave pública/anon (puede estar expuesta en el cliente)
NEXT_PUBLIC_SUPABASE_URL=https://TU_PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=TU_ANON_PUBLIC_KEY

# Clave de servicio (SOLO servidor - NUNCA exponer).
# Requerida para la gestión de usuarios (módulo admin).
# Supabase → Project Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=TU_SERVICE_ROLE_KEY
